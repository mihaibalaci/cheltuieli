[Unit]
Description=Cheltuieli - Personal Finance Tracker
After=network.target

[Service]
Type=simple
User=cheltuieli
WorkingDirectory=/opt/cheltuieli/backend
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cheltuieli

Environment=NODE_ENV=production
Environment=PORT=3001
Environment=DB_PATH=/opt/cheltuieli/data/cheltuieli.db

[Install]
WantedBy=multi-user.target
